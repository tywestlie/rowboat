<% content_for :title, @dataset.name %>

<div class="flex flex-col gap-6">
  <p>
    <%= link_to "← All datasets", datasets_path, class: "inline-flex min-h-11 items-center text-amber hover:underline" %>
  </p>

  <div class="flex flex-col gap-2">
    <h1 class="font-display text-2xl font-semibold tracking-tight text-signal sm:text-3xl lg:text-4xl"><%= @dataset.name %></h1>
    <p class="text-muted">
      <%= number_with_delimiter(@dataset.row_count) %> rows
      &middot; imported <%= @dataset.imported_at&.to_fs(:long) || "never" %>
      <% if @dataset.safe_source_url %>
        &middot; <%= link_to "source", @dataset.safe_source_url, class: "text-amber hover:underline" %>
      <% end %>
    </p>
  </div>

  <p class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <%= link_to "Surprise me", random_dataset_path(@dataset), class: "inline-flex min-h-11 items-center text-amber hover:underline" %>
    <span class="text-muted">&middot;</span>
    <%= link_to "Extremes leaderboard", extremes_dataset_path(@dataset), class: "inline-flex min-h-11 items-center text-amber hover:underline" %>
  </p>

  <% if has_hostname_column?(@columns) %>
    <div
      data-controller="host-filter"
      data-host-filter-hosts-url-value="<%= hosts_dataset_path(@dataset) %>"
      class="flex flex-col gap-2"
    >
      <div class="flex flex-wrap items-center gap-3">
        <label for="host-filter-input" class="text-sm text-muted">Host star</label>
        <div class="relative">
          <input
            type="text"
            id="host-filter-input"
            data-host-filter-target="input"
            data-action="input->host-filter#onInput focus->host-filter#onInput keydown->host-filter#onKeydown blur->host-filter#onBlur"
            placeholder="All systems"
            value="<%= @host %>"
            autocomplete="off"
            class="min-h-11 w-64 rounded-md border border-grid-line bg-panel px-3 text-sm text-signal placeholder:text-muted focus:border-amber focus:outline-none"
          >
          <ul
            data-host-filter-target="menu"
            class="absolute z-20 mt-1 hidden max-h-72 w-72 list-none overflow-y-auto rounded-md border border-grid-line bg-panel py-1 shadow-lg"
          ></ul>
        </div>
        <label class="flex items-center gap-2 text-sm text-muted">
          <input
            type="checkbox"
            data-host-filter-target="allToggle"
            data-action="change->host-filter#onInput"
            class="h-4 w-4 rounded border-grid-line"
          >
          Include single-planet systems
        </label>
        <% if @host %>
          <%= link_to "Clear filter", dataset_path(@dataset), class: "inline-flex min-h-11 items-center text-amber hover:underline" %>
        <% end %>
      </div>

      <p class="text-sm text-muted">
        <% if @host %>
          Showing <%= number_with_delimiter(@rows.total_count) %> planet<%= "s" unless @rows.total_count == 1 %> around
          <span class="text-signal"><%= @host %></span>
        <% else %>
          Showing all <%= number_with_delimiter(@dataset.row_count) %> planets
        <% end %>
      </p>
    </div>
  <% end %>

  <% if @starfield_points.present? %>
    <div
      data-controller="starfield"
      data-starfield-points-value="<%= @starfield_points.to_json %>"
      data-starfield-dataset-id-value="<%= @dataset.id %>"
      data-starfield-mode-value="<%= @starfield_mode %>"
      class="relative"
    >
      <canvas data-starfield-target="canvas" class="block w-full rounded-lg border border-grid-line"></canvas>
      <div
        data-starfield-target="tooltip"
        class="pointer-events-none fixed z-10 hidden rounded-md border border-grid-line bg-panel px-3 py-2 text-xs shadow-lg"
      ></div>
    </div>
  <% end %>

  <% if @columns.empty? %>
    <p class="italic text-muted">This dataset has no columns defined.</p>
  <% elsif @rows.empty? %>
    <p class="italic text-muted">This dataset has no rows.</p>
  <% else %>
    <div class="overflow-x-auto rounded-lg border border-grid-line bg-panel">
      <table class="w-full min-w-[640px] border-collapse text-sm">
        <thead>
          <tr>
            <% @columns.each do |column| %>
              <% numeric = column.data_type.in?(%w[integer float]) %>
              <th class="border-b border-grid-line px-4 py-3 <%= numeric ? "text-right" : "text-left" %> text-xs font-medium uppercase tracking-wider text-muted">
                <%= column.display_name.presence || column.name %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr>
              <% @columns.each do |column| %>
                <% numeric = column.data_type.in?(%w[integer float]) %>
                <td class="border-b border-grid-line px-4 py-2 <%= numeric ? "text-right font-mono" : "" %> text-signal">
                  <%= row.data[column.name] %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= paginate @rows %>
  <% end %>
</div>
