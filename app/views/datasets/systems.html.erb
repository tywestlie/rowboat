<% content_for :title, "#{@dataset.name} — Systems" %>

<div class="flex flex-col gap-6">
  <p>
    <%= link_to "← All datasets", datasets_path, class: "inline-flex min-h-11 items-center text-amber hover:underline" %>
  </p>

  <div class="flex flex-col gap-2">
    <h1 class="font-display text-2xl font-semibold tracking-tight text-signal sm:text-3xl lg:text-4xl"><%= @dataset.name %></h1>
    <p class="text-muted">Browsing by star system</p>
  </div>

  <p class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <%= link_to "Browse all planets", dataset_path(@dataset), class: "inline-flex min-h-11 items-center text-amber hover:underline" %>
    <span class="text-muted">&middot;</span>
    <%= link_to "Surprise me", random_dataset_path(@dataset), class: "inline-flex min-h-11 items-center text-amber hover:underline" %>
    <span class="text-muted">&middot;</span>
    <%= link_to "Extremes leaderboard", extremes_dataset_path(@dataset), class: "inline-flex min-h-11 items-center text-amber hover:underline" %>
  </p>

  <div class="flex flex-wrap items-center gap-3">
    <p class="text-sm text-muted">
      Showing <%= number_with_delimiter(@systems.size) %> system<%= "s" unless @systems.size == 1 %>
    </p>
    <% if @include_single_planet %>
      <%= link_to "Hide single-planet systems", systems_dataset_path(@dataset), class: "inline-flex min-h-11 items-center text-amber hover:underline" %>
    <% else %>
      <%= link_to "Include single-planet systems", systems_dataset_path(@dataset, all: "1"), class: "inline-flex min-h-11 items-center text-amber hover:underline" %>
    <% end %>
  </div>

  <% if @systems.empty? %>
    <p class="italic text-muted">This dataset has no host star data.</p>
  <% else %>
    <div class="overflow-x-auto rounded-lg border border-grid-line bg-panel">
      <table class="w-full min-w-[480px] border-collapse text-sm">
        <thead>
          <tr>
            <th class="border-b border-grid-line px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted">Host Star</th>
            <th class="border-b border-grid-line px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-muted">Planets</th>
          </tr>
        </thead>
        <tbody>
          <% @systems.each do |system| %>
            <tr>
              <td class="border-b border-grid-line px-4 py-3 text-signal">
                <%= link_to system[:hostname], dataset_path(@dataset, hostname: system[:hostname]),
                      class: "inline-flex min-h-11 items-center text-amber hover:underline" %>
              </td>
              <td class="border-b border-grid-line px-4 py-3 text-right font-mono text-signal"><%= number_with_delimiter(system[:planet_count]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
