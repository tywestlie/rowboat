<% content_for :title, "Datasets" %>

<div class="flex flex-col gap-6">
  <h1 class="font-display text-2xl font-semibold tracking-tight text-signal sm:text-3xl lg:text-4xl">Datasets</h1>

  <% if @datasets.any? %>
    <div class="overflow-x-auto rounded-lg border border-grid-line bg-panel">
      <table class="w-full min-w-[480px] border-collapse text-sm">
        <thead>
          <tr>
            <th class="border-b border-grid-line px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted">Name</th>
            <th class="border-b border-grid-line px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-muted">Rows</th>
            <th class="border-b border-grid-line px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted">Imported</th>
          </tr>
        </thead>
        <tbody>
          <% @datasets.each do |dataset| %>
            <tr>
              <td class="border-b border-grid-line px-4 py-3 text-signal">
                <% link_target = has_hostname_column?(dataset.dataset_columns) ? systems_dataset_path(dataset) : dataset_path(dataset) %>
                <%= link_to dataset.name, link_target,
                      class: "inline-flex min-h-11 items-center text-amber hover:underline" %>
              </td>
              <td class="border-b border-grid-line px-4 py-3 text-right font-mono text-signal"><%= number_with_delimiter(dataset.row_count) %></td>
              <td class="border-b border-grid-line px-4 py-3 text-muted"><%= dataset.imported_at&.to_fs(:long) || "Never" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="italic text-muted">No datasets have been imported yet.</p>
  <% end %>
</div>
