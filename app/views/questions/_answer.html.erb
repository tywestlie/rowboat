<div id="<%= dom_id(query, :answer) %>" class="flex flex-col gap-4">
  <p class="rounded-lg border border-grid-line bg-panel px-4 py-4 text-signal"><%= query.result_summary %></p>

  <% case result.kind %>
  <% when :value %>
    <p class="font-display text-3xl font-semibold text-amber"><%= result.value %></p>

  <% when :table %>
    <% if result.rows.empty? %>
      <p class="italic text-muted">No matching records.</p>
    <% else %>
      <div class="overflow-x-auto rounded-lg border border-grid-line bg-panel">
        <table class="w-full min-w-[480px] border-collapse text-sm">
          <thead>
            <tr>
              <% result.rows.first.attributes.except("id", "created_at", "updated_at").each_key do |column| %>
                <th class="border-b border-grid-line px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted"><%= column %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% result.rows.each do |row| %>
              <tr>
                <% row.attributes.except("id", "created_at", "updated_at").each_value do |value| %>
                  <td class="border-b border-grid-line px-4 py-2 text-signal"><%= value %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

  <% when :chart %>
    <% if result.rows.empty? %>
      <p class="italic text-muted">No matching records.</p>
    <% else %>
      <% max_value = result.rows.values.max.to_f.nonzero? || 1 %>
      <div class="flex flex-col gap-2 rounded-lg border border-grid-line bg-panel p-4">
        <% result.rows.each do |group, value| %>
          <div class="flex items-center gap-3 text-sm">
            <span class="w-32 shrink-0 truncate text-muted" title="<%= group %>"><%= group %></span>
            <div class="h-4 flex-1 rounded bg-space-navy">
              <div class="h-4 rounded bg-amber" style="width: <%= (value.to_f / max_value * 100).round(1) %>%"></div>
            </div>
            <span class="w-16 shrink-0 text-right font-mono text-signal"><%= value %></span>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
