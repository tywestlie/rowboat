<% content_for :title, "Ask" %>

<% content_for :active_nav, "ask" %>

<div class="flex flex-col gap-6">
  <h1 class="font-display text-2xl font-semibold tracking-tight text-signal sm:text-3xl lg:text-4xl">Your question</h1>
  <p class="text-lg text-signal">&ldquo;<%= @query.question %>&rdquo;</p>

  <%= turbo_stream_from @query %>

  <% if @query.result_summary.blank? %>
    <div id="<%= dom_id(@query, :answer) %>" class="flex items-center gap-3 rounded-lg border border-grid-line bg-panel px-4 py-6 text-muted">
      <span class="animate-pulse">Thinking&hellip;</span>
    </div>
  <% elsif @result %>
    <%= render "answer", query: @query, result: @result %>
  <% else %>
    <%= render "error", query: @query %>
  <% end %>

  <%= link_to "Ask another question", ask_path, class: "text-sm text-amber hover:underline" %>
</div>
