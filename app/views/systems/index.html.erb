<% content_for :title, "Star Systems" %>

<div class="flex flex-col gap-6">
  <%= render "shared/nav", active: :systems %>

  <h1 class="font-display text-2xl font-semibold tracking-tight text-signal sm:text-3xl lg:text-4xl">Star Systems</h1>

  <div class="flex flex-wrap items-center gap-3">
    <p class="text-sm text-muted">
      Showing <%= number_with_delimiter(@systems.size) %> system<%= "s" unless @systems.size == 1 %>
    </p>
    <% if @include_single_planet %>
      <%= link_to "Hide single-planet systems", systems_path, class: "inline-flex min-h-11 items-center text-amber hover:underline" %>
    <% else %>
      <%= link_to "Include single-planet systems", systems_path(all: "1"), class: "inline-flex min-h-11 items-center text-amber hover:underline" %>
    <% end %>
  </div>

  <% if @systems_chart_points.present? %>
    <div
      data-controller="systems-chart"
      data-systems-chart-points-value="<%= @systems_chart_points.to_json %>"
      class="relative"
    >
      <canvas data-systems-chart-target="canvas" class="block w-full rounded-lg border border-grid-line"></canvas>
      <div
        data-systems-chart-target="tooltip"
        class="pointer-events-none fixed z-10 hidden rounded-md border border-grid-line bg-panel px-3 py-2 text-xs shadow-lg"
      ></div>
    </div>
  <% end %>

  <% if @systems.empty? %>
    <p class="italic text-muted">This dataset has no host star data.</p>
  <% else %>
    <div class="overflow-x-auto rounded-lg border border-grid-line bg-panel">
      <table class="w-full min-w-[480px] border-collapse text-sm">
        <thead>
          <tr>
            <th class="border-b border-grid-line px-4 py-3 text-left text-xs font-medium uppercase tracking-wider text-muted">Host Star</th>
            <th class="border-b border-grid-line px-4 py-3 text-right text-xs font-medium uppercase tracking-wider text-muted">Planets</th>
          </tr>
        </thead>
        <tbody>
          <% @systems.each do |system| %>
            <tr>
              <td class="border-b border-grid-line px-4 py-3 text-signal">
                <%= link_to system[:hostname], system_path(system[:hostname]),
                      class: "inline-flex min-h-11 items-center text-amber hover:underline" %>
              </td>
              <td class="border-b border-grid-line px-4 py-3 text-right font-mono text-signal"><%= number_with_delimiter(system[:planet_count]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
